<Window x:Class="WpfApp6.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Арома Дом — Материалы"
        Height="720"
        Width="1100"
        MinHeight="550"
        MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#F4E6D4"
        FontFamily="Georgia">

    <Window.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#8A5A44"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#D8C1AD"/>
            <Setter Property="Foreground" Value="#3B2B24"/>
        </Style>

        <Style x:Key="MaterialCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0CDBB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="White"
                CornerRadius="8"
                Padding="18"
                Margin="0,0,0,16">
            <DockPanel>
                <StackPanel>
                    <TextBlock Text="АРОМА ДОМ"
                               FontSize="25"
                               FontWeight="Bold"
                               Foreground="#8A5A44"/>

                    <TextBlock Text="Управление материалами"
                               FontSize="14"
                               Foreground="#6B5549"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <TextBlock DockPanel.Dock="Right"
                           Text="Склад и рецептуры"
                           FontSize="13"
                           Foreground="#8A5A44"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Margin="20,0,0,0"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Материалы"
                       FontSize="21"
                       FontWeight="Bold"
                       Foreground="#3B2B24"
                       VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Обновить"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="RefreshButton_Click"/>

                <Button Content="Добавить материал"
                        Style="{StaticResource ActionButtonStyle}"
                        Click="AddMaterialButton_Click"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="MaterialsItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource MaterialCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="#3B2B24"
                                               TextWrapping="Wrap"/>

                                    <TextBlock Text="{Binding Type}"
                                               FontSize="13"
                                               Foreground="#8A5A44"
                                               Margin="0,4,0,10"/>

                                    <WrapPanel>
                                        <TextBlock Text="Цена: "
                                                   FontWeight="Bold"
                                                   Foreground="#3B2B24"/>
                                        <TextBlock Text="{Binding PriceText}"
                                                   Foreground="#3B2B24"
                                                   Margin="0,0,18,0"/>

                                        <TextBlock Text="На складе: "
                                                   FontWeight="Bold"
                                                   Foreground="#3B2B24"/>
                                        <TextBlock Text="{Binding WarehouseText}"
                                                   Foreground="#3B2B24"
                                                   Margin="0,0,18,0"/>

                                        <TextBlock Text="Минимальный остаток: "
                                                   FontWeight="Bold"
                                                   Foreground="#3B2B24"/>
                                        <TextBlock Text="{Binding MinimumText}"
                                                   Foreground="#3B2B24"/>
                                    </WrapPanel>

                                    <TextBlock Text="{Binding PackageText}"
                                               FontSize="12"
                                               Foreground="#6B5549"
                                               Margin="0,8,0,0"/>

                                    <TextBlock Text="{Binding RequiredText}"
                                               FontSize="12"
                                               Foreground="#6B5549"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right"
                                            Margin="15,0,0,0">
                                    <Button Content="Продукция по рецептуре"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Click="ShowProductsButton_Click"
                                            Tag="{Binding Id}"
                                            Margin="0,0,0,8"/>

                                    <Button Content="Редактировать"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="EditMaterialButton_Click"
                                            Tag="{Binding Id}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="3"
                Background="White"
                CornerRadius="5"
                Padding="10"
                Margin="0,12,0,0">
            <TextBlock x:Name="StatusText"
                       Text="Загрузка материалов..."
                       Foreground="#6B5549"
                       FontSize="12"
                       TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>
