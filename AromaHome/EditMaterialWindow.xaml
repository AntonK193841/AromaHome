<Window x:Class="WpfApp6.EditMaterialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Материал"
        Height="650"
        Width="560"
        MinHeight="600"
        MinWidth="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#FFFFFF"
        FontFamily="Georgia">

    <Window.Resources>
        <SolidColorBrush x:Key="CardBackground" Color="#F4E6D4"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#8A5A44"/>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#5A4438"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>

        <Style x:Key="FieldStyle" TargetType="Control">
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource CardBackground}"
                CornerRadius="8"
                Padding="14"
                Margin="0,0,0,10">
            <TextBlock x:Name="FormTitle"
                       Text="Данные материала"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="{StaticResource AccentBrush}"/>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Тип материала *"
                           Style="{StaticResource FieldLabelStyle}"/>
                <ComboBox x:Name="TypeComboBox"
                          IsEditable="True"
                          MinHeight="34"
                          Style="{StaticResource FieldStyle}"/>

                <TextBlock Text="Наименование *"
                           Style="{StaticResource FieldLabelStyle}"/>
                <TextBox x:Name="TitleTextBox"
                         Style="{StaticResource FieldStyle}"/>

                <TextBlock Text="Цена за единицу (неотрицательная, до 2 знаков) *"
                           Style="{StaticResource FieldLabelStyle}"/>
                <TextBox x:Name="PriceTextBox"
                         Style="{StaticResource FieldStyle}"
                         ToolTip="Например: 450,00"/>

                <TextBlock Text="Единица измерения *"
                           Style="{StaticResource FieldLabelStyle}"/>
                <TextBox x:Name="UnitTextBox"
                         Style="{StaticResource FieldStyle}"
                         ToolTip="Например: кг, шт., л"/>

                <TextBlock Text="Количество в упаковке *"
                           Style="{StaticResource FieldLabelStyle}"/>
                <TextBox x:Name="PackageCountTextBox"
                         Style="{StaticResource FieldStyle}"/>

                <TextBlock Text="Количество на складе *"
                           Style="{StaticResource FieldLabelStyle}"/>
                <TextBox x:Name="WarehouseCountTextBox"
                         Style="{StaticResource FieldStyle}"/>

                <TextBlock Text="Минимальное количество *"
                           Style="{StaticResource FieldLabelStyle}"/>
                <TextBox x:Name="MinimumCountTextBox"
                         Style="{StaticResource FieldStyle}"/>

                <TextBlock Text="* Обязательные поля. Количества указываются целыми неотрицательными числами."
                           FontSize="11"
                           Foreground="#725B4E"
                           TextWrapping="Wrap"
                           Margin="0,10,0,6"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button x:Name="SaveButton"
                    Content="Сохранить"
                    Style="{StaticResource ActionButtonStyle}"
                    Click="SaveButton_Click"/>

            <Button Content="Отмена"
                    Style="{StaticResource ActionButtonStyle}"
                    Background="#76665D"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>