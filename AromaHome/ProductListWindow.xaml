<Window x:Class="WpfApp6.ProductListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Продукция по материалу"
        Height="650"
        Width="900"
        MinHeight="450"
        MinWidth="650"
        WindowStartupLocation="CenterOwner"
        Background="#FFFFFF"
        FontFamily="Georgia">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="#F4E6D4"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="АРОМА ДОМ"
                           FontSize="23"
                           FontWeight="Bold"
                           Foreground="#8A5A44"/>
                <TextBlock Text="Продукция, использующая выбранный материал"
                           FontSize="14"
                           Margin="0,6,0,0"
                           Foreground="#5A4438"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="Выбранный материал"
                       FontSize="13"
                       Foreground="#725B4E"/>
            <TextBlock x:Name="MaterialTitleText"
                       Text="Материал"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#8A5A44"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="#F4E6D4"
                    CornerRadius="6"
                    Padding="12"
                    Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Наименование продукции"
                               FontWeight="Bold"
                               Foreground="#5A4438"/>

                    <TextBlock Grid.Column="1"
                               Text="Количество материала"
                               FontWeight="Bold"
                               Foreground="#5A4438"
                               TextWrapping="Wrap"/>
                </Grid>
            </Border>

            <ListView x:Name="ProductsListView"
                      Grid.Row="1"
                      BorderThickness="0"
                      Background="#FFFFFF"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#F4E6D4"
                                CornerRadius="6"
                                Padding="12"
                                Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="200"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding ProductName}"
                                           VerticalAlignment="Center"
                                           FontSize="14"
                                           Foreground="#38271F"
                                           TextWrapping="Wrap"/>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding QuantityText}"
                                           VerticalAlignment="Center"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="#8A5A44"
                                           TextWrapping="Wrap"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StatusText"
                       Text="Готово"
                       VerticalAlignment="Center"
                       Foreground="#725B4E"
                       TextWrapping="Wrap"
                       Margin="0,0,8,0"/>

            <Button Grid.Column="1"
                    Content="Обновить"
                    Padding="16,9"
                    Margin="4"
                    Background="#8A5A44"
                    Foreground="White"
                    BorderThickness="0"
                    FontFamily="Georgia"
                    Click="RefreshButton_Click"/>

            <Button Grid.Column="2"
                    Content="Назад"
                    Padding="16,9"
                    Margin="4"
                    Background="#76665D"
                    Foreground="White"
                    BorderThickness="0"
                    FontFamily="Georgia"
                    Click="BackButton_Click"/>
        </Grid>
    </Grid>
</Window>